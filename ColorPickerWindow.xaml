<Window x:Class="每日一句.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="拾色器"
        Width="340" SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- ===== 主题色：初值仅为设计期占位，打开时由 ThemeHelper.ApplyTo 覆盖 ===== -->
        <SolidColorBrush x:Key="BgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="#F7F7F7"/>
        <SolidColorBrush x:Key="TextBrush" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="Text2Brush" Color="#5E5E5E"/>
        <SolidColorBrush x:Key="HintBrush" Color="#8A8A8A"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E8E8E8"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#0F6CBD"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#EAF3FB"/>
        <SolidColorBrush x:Key="NavHoverBrush" Color="#1A7F7F7F"/>
        <SolidColorBrush x:Key="TrackOffBrush" Color="#C8C8C8"/>

        <!-- ===== 文本 ===== -->
        <Style x:Key="TitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource HintBrush}"/>
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
        </Style>

        <!-- ===== 关闭按钮 ===== -->
        <Style x:Key="WinCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 数值输入框 ===== -->
        <Style x:Key="NumBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei UI"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="4" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="error">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E81123"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 十六进制输入框：Tag="error" 时红框 ===== -->
        <Style x:Key="HexBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei UI"/>
            <Setter Property="MaxLength" Value="7"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="error">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E81123"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 底部按钮 ===== -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3D87D4"/>
                    <Setter Property="BorderBrush" Value="#3D87D4"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- 无边框窗口自绘 1px 描边 -->
    <Border Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== 标题栏（可拖动）===== -->
            <Grid Grid.Row="0" Height="44" Background="{DynamicResource SidebarBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="拾色器" Style="{StaticResource TitleStyle}" Margin="16,0,0,0"/>
                <Button Content="✕" Style="{StaticResource WinCloseButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                        Click="Cancel_Click"/>
            </Grid>

            <!-- ===== 内容 ===== -->
            <StackPanel Grid.Row="1" Margin="16,14,16,16">

                <!-- 色域面板 + 色相滑块 -->
                <Grid Height="256">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="256"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 色域面板 -->
                    <Grid Grid.Column="0" Width="256" Height="256"
                          PreviewMouseLeftButtonDown="Field_MouseDown"
                          PreviewMouseMove="Field_MouseMove"
                          PreviewMouseLeftButtonUp="Field_MouseUp">
                        <Image x:Name="FieldImage" Width="256" Height="256"/>
                        <Canvas Width="256" Height="256" IsHitTestVisible="False">
                            <Ellipse x:Name="FieldCursor" Width="10" Height="10"
                                     Stroke="White" StrokeThickness="2"
                                     Fill="Transparent"/>
                        </Canvas>
                    </Grid>

                    <!-- 色相滑块 -->
                    <Grid Grid.Column="1" Width="15" Height="256" HorizontalAlignment="Left" Margin="12,0,14,0"
                          PreviewMouseLeftButtonDown="Slider_MouseDown"
                          PreviewMouseMove="Slider_MouseMove"
                          PreviewMouseLeftButtonUp="Slider_MouseUp">
                        <Image x:Name="HueImage" Width="15" Height="256"/>
                        <Canvas Width="15" Height="256" IsHitTestVisible="False">
                            <Rectangle x:Name="HueCursorL" Width="4" Height="3" Fill="White"
                                       Stroke="#999" StrokeThickness="0.5"/>
                            <Rectangle x:Name="HueCursorR" Width="4" Height="3" Fill="White"
                                       Stroke="#999" StrokeThickness="0.5"/>
                        </Canvas>
                    </Grid>
                </Grid>

                <!-- HSB 数值输入 -->
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="H:" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="HBox" Style="{StaticResource NumBoxStyle}" TextChanged="HBox_TextChanged"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                        <TextBlock Text="S:" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="SBox" Style="{StaticResource NumBoxStyle}" TextChanged="SBox_TextChanged"/>
                        <TextBlock Text="%" Style="{StaticResource LabelStyle}" Margin="1,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                        <TextBlock Text="B:" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="BBox" Style="{StaticResource NumBoxStyle}" TextChanged="BBox_TextChanged"/>
                        <TextBlock Text="%" Style="{StaticResource LabelStyle}" Margin="1,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- RGB 数值输入 -->
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="R:" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="RBox" Style="{StaticResource NumBoxStyle}" TextChanged="RBox_TextChanged"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                        <TextBlock Text="G:" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="GBox" Style="{StaticResource NumBoxStyle}" TextChanged="GBox_TextChanged"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                        <TextBlock Text="B:" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="BlueBox" Style="{StaticResource NumBoxStyle}" TextChanged="BlueBox_TextChanged"/>
                    </StackPanel>
                </StackPanel>

                <!-- Hex 输入 -->
                <Grid Margin="0,8,0,0">
                    <TextBox x:Name="HexBox" Style="{StaticResource HexBoxStyle}"
                             TextChanged="HexBox_TextChanged"/>
                    <TextBlock x:Name="HexHint" Text="#RRGGBB"
                               FontSize="13" FontFamily="Consolas, Microsoft YaHei UI"
                               Foreground="{DynamicResource HintBrush}"
                               Margin="13,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="Collapsed"/>
                </Grid>

                <!-- 当前色 / 新色对比预览 -->
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <StackPanel>
                        <Border x:Name="CurrentPreview" Width="80" Height="40" CornerRadius="4"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                SnapsToDevicePixels="True"/>
                        <TextBlock Text="当前" HorizontalAlignment="Center" FontSize="11"
                                   Foreground="{DynamicResource Text2Brush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <TextBlock Text="▶" VerticalAlignment="Center" Margin="10,0,10,0" FontSize="14"
                               Foreground="{DynamicResource Text2Brush}"/>
                    <StackPanel>
                        <Border x:Name="NewPreview" Width="80" Height="40" CornerRadius="4"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                SnapsToDevicePixels="True"/>
                        <TextBlock Text="新色" HorizontalAlignment="Center" FontSize="11"
                                   Foreground="{DynamicResource Text2Brush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- 确定 / 取消 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="取消" Style="{StaticResource ActionButtonStyle}" Click="Cancel_Click"/>
                    <Button Content="确定" Style="{StaticResource PrimaryButtonStyle}" Click="Confirm_Click"/>
                </StackPanel>

            </StackPanel>
        </Grid>
    </Border>
</Window>