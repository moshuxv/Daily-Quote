<Window x:Class="每日一句.ContextMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="菜单"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3A3A3A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#4C4C4C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="#1F1F1F" CornerRadius="10" Padding="6" Opacity="0.96">
        <StackPanel>
            <Button x:Name="BtnRefresh" Content="刷新" Style="{StaticResource MenuButton}" Click="BtnRefresh_Click" />
            <Button x:Name="BtnCopy" Content="复制" Style="{StaticResource MenuButton}" Click="BtnCopy_Click" />
            <Button x:Name="BtnSettings" Content="进入设置" Style="{StaticResource MenuButton}" Click="BtnSettings_Click" />
            <Button x:Name="BtnLock" Content="锁定位置" Style="{StaticResource MenuButton}" Click="BtnLock_Click" />
            <Button x:Name="BtnUnlock" Content="取消锁定" Style="{StaticResource MenuButton}" Click="BtnUnlock_Click" />
            <Button x:Name="BtnQuit" Content="退出程序" Foreground="#FF6B6B" Style="{StaticResource MenuButton}" Click="BtnQuit_Click" />
        </StackPanel>
    </Border>
</Window>
