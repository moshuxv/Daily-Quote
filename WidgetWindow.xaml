<Window x:Class="每日一句.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="每日一句"
        SizeToContent="WidthAndHeight"
        MinWidth="240"
        MinHeight="160"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        LocationChanged="OnLocationChanged">

    <!-- 渐变圆角背景卡片 + 3 个 TextBlock；右键菜单由独立顶层窗口 ContextMenuWindow 承载 -->
    <Grid>
        <Border x:Name="Card"
                Margin="8"
                MaxWidth="560"
                CornerRadius="14"
                Cursor="Hand"
                MouseDown="Card_MouseDown"
                MouseMove="Card_MouseMove"
                MouseUp="Card_MouseUp"
                PreviewMouseRightButtonDown="Card_PreviewRightDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22"
                                  ShadowDepth="3"
                                  Direction="270"
                                  Opacity="0.35"
                                  Color="#000000" />
            </Border.Effect>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop x:Name="GradStart" Offset="0" Color="#0F6CBD" />
                    <GradientStop x:Name="GradEnd" Offset="1" Color="#3B8CDF" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid Margin="20,16,20,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 英文句：FontSize 粗体 -->
                <TextBlock x:Name="EngText"
                           TextWrapping="Wrap"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="White" />

                <!-- 中文：FontSize - 3 -->
                <TextBlock x:Name="ZhText"
                           Grid.Row="1"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           FontSize="15"
                           Foreground="White" />

                <!-- 作者：左对齐（与英文/中文一致，打字机逐字方向统一为左→右） -->
                <TextBlock x:Name="AuthorText"
                           Grid.Row="2"
                           Margin="0,8,0,0"
                           TextAlignment="Left"
                           VerticalAlignment="Bottom"
                           FontSize="12"
                           Opacity="0.85"
                           Foreground="White" />
            </Grid>
        </Border>
    </Grid>
</Window>
